# Copy to .env for LOCAL runs (never commit the real .env).
# In GitHub Actions these are set as repository Secrets instead.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # Settings -> API -> service_role

# --- optional tuning (sensible defaults already in scraper.py) ---
# PERIODS=1,3,6,12
# ORDER_BYS=rating,roi,profit
# REQUEST_DELAY=0.4
# FULL_BACKFILL=0
# ONLY_SLUGS=money-bags,thebanker   # restrict run for testing
